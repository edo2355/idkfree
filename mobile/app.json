{
  "expo": {
    "name": "IDKFREE",
    "slug": "idkfree",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "idkfree",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.idkfree.mobile"
    },
    "android": {
      "package": "app.idkfree.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050505"
      },
      "minSdkVersion": 24,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-video",
      "expo-camera",
      "@livekit/react-native-expo-plugin",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.2.10"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a5993b12-c5b9-43c3-b222-8d60f5e206f4"
      }
    }
  }
}