{
  "expo": {
    "name": "IDKFREE",
    "slug": "idkfree",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.idkfree.mobile"
    },
    "android": {
      "package": "app.idkfree.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050505"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "enableProguardInReleaseBuilds": true,
      "enableShrinkResources": true,
      "usesCleartextTraffic": true,
      "minSdkVersion": 24
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "IDKFREE necesita acceso a tus fotos para guardar el carnet.",
          "savePhotosPermission": "IDKFREE guarda el carnet en tu galer\u00eda.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-video",
      "@config-plugins/react-native-webrtc",
      "@livekit/react-native-expo-plugin"
    ],
    "extra": {
      "apiUrl": "https://idkfree.onrender.com/api",
      "eas": {
        "projectId": "a5993b12-c5b9-43c3-b222-8d60f5e206f4"
      }
    },
    "jsEngine": "hermes",
    "scheme": "idkfree"
  }
}