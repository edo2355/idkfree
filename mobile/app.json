{
  "expo": {
    "name": "IDKFREE",
    "slug": "idkfree",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "idkfree",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.idkfree.mobile"
    },
    "android": {
      "package": "app.idkfree.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050505"
      },
      "minSdkVersion": 24
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-video",
      "expo-camera",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow IDKFREE to access your camera",
          "microphonePermission": "Allow IDKFREE to access your microphone"
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class livekit.org.jni_zero.** { *; }\n-keep class org.webrtc.** { *; }\n-keep class com.livekit.** { *; }\n-keep class io.livekit.** { *; }\n-dontwarn org.jni_zero.JniZeroJni"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a5993b12-c5b9-43c3-b222-8d60f5e206f4"
      }
    }
  }
}