# Reintentar 5 veces si falla la descarga
fetch-retries=5
# Esperar mínimo 20 segundos antes de reintentar
fetch-retry-mintimeout=20000
# No esperar más de 120 segundos (2 min) en un reintento
fetch-retry-maxtimeout=120000
# Usar la caché local si está disponible (ahorra datos)
prefer-offline=true
# Timeout global para la operación (10 minutos)
timeout=600000
